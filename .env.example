# ⚠️ Este é um MODELO de variáveis de ambiente (não contém segredos reais).
#
# O arquivo REAL usado no desenvolvimento local é `.env.local`.
# `.env.local` está listado em `.gitignore` e NUNCA deve ser commitado.
# Copie este `.env.example` para `.env.local` e preencha os valores reais.
#
# DATABASE_URL, JWT_SECRET e ENCRYPTION_KEY são OBRIGATÓRIOS para o app
# rodar (src/lib/env.ts exige DATABASE_URL postgresql://, JWT_SECRET >= 32 chars
# e ENCRYPTION_KEY >= 32 chars, sem defaults).
# Para gerar chaves seguras: `openssl rand -base64 32 | tr -d '\n'`

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/captacao_leads

# Auth
JWT_SECRET=your-32-character-jwt-secret-key-change-this
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# Meta API (Optional for core boot, required when Meta operations are invoked)
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret
META_REDIRECT_URI=https://your-app.com/api/meta/oauth/callback
META_API_VERSION=v21.0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-app.com/api/auth/callback/google
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI (Optional for core boot, required when AI operations are invoked)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BUDGET_USD=100.00

# Email (Resend)
RESEND_API_KEY=your-resend-api-key

# Platform limits (safety)
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS_START=9
OPERATING_HOURS_END=20
OPERATING_TIMEZONE=Europe/Lisbon
